	status = "okay";
};

&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&sdhci {
	status = "okay";
	bus-width = <8>;
	max-frequency = <0x7270e00>;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd>;
};

&sdmmc0 {
	status = "okay";
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
};

&sdmmc1 {
	status = "okay";
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	supports-sdio;
	disable-wp;
	keep-power-in-suspend;
	broken-cd;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk>;
	sd-uhs-sdr104;
	rockchip,default-sample-phase = <0x5a>;
	vmmc-supply = <&vcc3v3_sys>;
	vqmmc-supply = <&vcc_1v8>;
};

&tsadc {
	status = "okay";
};

&u2phy1_host {
	status = "okay";
	phy-supply = <&vcc5v0_usb_host1>;
