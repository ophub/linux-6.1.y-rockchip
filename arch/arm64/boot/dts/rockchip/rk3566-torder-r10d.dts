&u2phy1_otg {
	status = "okay";
	phy-supply = <&vcc5v0_usb_host1>;
};

&uart1 {
	pinctrl-0 = <&uart1m0_ctsn &uart1m0_rtsn &uart1m0_xfer>;
	status = "okay";
	uart-has-rtscts;
	dma-names = "tx", "rx";
};

&usb2phy0 {
	status = "okay";
};

&usb2phy0_host {
	status = "okay";
	phy-supply = <&vcc5v0_usb_host1>;
