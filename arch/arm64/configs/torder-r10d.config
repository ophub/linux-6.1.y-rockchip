CONFIG_SPARD_WLAN_SUPPORT=y
CONFIG_RK_WIFI_DEVICE_UWE5621=y
CONFIG_WCN_BSP_DRIVER_BUILDIN=y
CONFIG_WLAN_UWE5621=m
CONFIG_RK_WIFI_DEVICE_UWE5622=n
CONFIG_WLAN_UWE5622=n
CONFIG_TTY_OVERY_SDIO=m
CONFIG_CFG80211=m
CONFIG_TOUCHSCREEN_GSL3673_800X1280=m
CONFIG_RFKILL=y
# Mesa uses Panfrost for the RK3566 Mali-G52 GPU.
CONFIG_DRM_PANFROST=m
# CONFIG_MALI400 is not set
# CONFIG_MALI_MIDGARD is not set
# CONFIG_MALI_BIFROST is not set

# Keep the built-in tablet LCD usable before the graphical desktop starts.
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
